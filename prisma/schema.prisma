generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Chat {
  id              String           @id @default(cuid())
  title           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        Message[]
  telegramSession TelegramSession?
}

model TelegramSession {
  telegramUserId String   @id
  chatId         String   @unique
  chat           Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  platform       String   @default("meta")
  updatedAt      DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String
  parts     Json
  createdAt DateTime @default(now())
}

/** Campaña o conjunto Meta para Informe IA y cron de activación. */
model MetaTrackEntity {
  id             String   @id @default(cuid())
  metaId         String
  type           String
  name           String
  campaignMetaId String?
  objective      String?
  updatedAt      DateTime @updatedAt
  operativeDays  MetaOperativeDay[]

  @@unique([metaId, type])
  @@index([type, campaignMetaId])
}

/** Snapshot diario por campaña/conjunto: gasto, ventas, puntos y estado (Informe IA). */
model MetaOperativeDay {
  id            String          @id @default(cuid())
  date          String
  entityId      String
  entity        MetaTrackEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  intentActive  Boolean         @default(false)
  metaWasActive Boolean         @default(false)
  sold          Boolean         @default(false)
  purchases     Int             @default(0)
  spend         Float           @default(0)
  cpa           Float           @default(0)
  points        Int?
  estadoKind    String          @default("neutral")
  estadoLabel   String          @default("—")
  notifyOlvido  Boolean         @default(false)
  rowHighlight  String          @default("none")
  updatedAt     DateTime        @updatedAt

  @@unique([date, entityId])
  @@index([date])
  @@index([entityId, date])
}

/** Totales de cuenta Meta guardados por día (Informe IA). */
model MetaInformeAccountDay {
  date             String   @id
  accountSpend     Float    @default(0)
  accountPurchases Int      @default(0)
  syncedAt         DateTime @updatedAt
}

enum ProductStatus {
  draft
  ready
  running
  archived
}

enum CreativeType {
  image
  video
}

enum CampaignStatus {
  draft
  ready
  running
  winner
  loser
  archived
}

enum CampaignStrategy {
  ABO
  CBO
}

/** Imagen o video reutilizable (asociable a variantes de producto). */
model Creative {
  id        String           @id @default(cuid())
  url       String           @unique
  type      CreativeType
  name      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[] @relation("CreativeToProductVariant")

  @@index([type])
  @@map("Creative")
}

/** Landing page reutilizable (asociable a varios productos). */
model LandingPage {
  id        String   @id @default(cuid())
  url       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]

  @@map("LandingPage")
}

/** Producto del catálogo (multi-plataforma). */
model Product {
  id           String        @id @default(cuid())
  name         String
  status       ProductStatus @default(draft)
  budget       Float         @default(0)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  variants     ProductVariant[]
  campaigns    ProductCampaign[]
  landingPages LandingPage[]

  @@index([status])
  @@map("TikTokProduct")
}

/** Variante del producto con creativos propios. */
model ProductVariant {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  updatedAt DateTime   @updatedAt
  creatives Creative[] @relation("CreativeToProductVariant")

  @@index([productId])
  @@map("TikTokProductVariant")
}

/** URL de landing guardada en catálogo global (reutilizable en productos). */
model LandingUrlCatalog {
  id        String   @id @default(cuid())
  url       String   @unique
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("LandingUrlCatalog")
}

/** Campaña TikTok configurable (borrador → lanzamiento). */
model Campaign {
  id        String         @id @default(cuid())
  name      String
  status    CampaignStatus @default(draft)
  strategy  CampaignStrategy
  config    Json
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
  @@map("Campaign")
}

/** Campaña vinculada a un producto para historial de ventas. */
model ProductCampaign {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  campaignId   String
  campaignName String?
  platform     String   @default("tiktok")
  createdAt    DateTime @default(now())

  @@unique([productId, campaignId, platform])
  @@index([productId])
  @@map("TikTokProductCampaign")
}

/** Ejecución manual de sincronización Dropi → SociaVault. */
model PendingSyncRun {
  id           String    @id @default(cuid())
  status       String    @default("running")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  imported     Int       @default(0)
  searched     Int       @default(0)
  matched      Int       @default(0)
  noMatch      Int       @default(0)
  errors       Int       @default(0)
  errorMessage String?

  @@index([startedAt])
  @@map("PendingSyncRun")
}

/** Favorito importado desde Dropi (productos pendientes). */
model DropiFavoriteProduct {
  id           String   @id @default(cuid())
  dropiId      String   @unique
  name         String
  url          String?
  imageUrl     String?
  imageUrls    Json     @default("[]")
  sku          String?
  price        Float?
  status       String   @default("IMPORTED")
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  matches      ProductPendingMatch[]

  @@index([status])
  @@index([updatedAt])
  @@map("DropiFavoriteProduct")
}

/** Resultado de búsqueda SociaVault (campaña Meta o video TikTok). */
model ProductPendingMatch {
  id         String               @id @default(cuid())
  favoriteId String
  favorite   DropiFavoriteProduct @relation(fields: [favoriteId], references: [id], onDelete: Cascade)
  matchType  String
  externalId String?
  title      String?
  pageName   String?
  score      Float                @default(0)
  previewUrl String?
  landingUrl String?
  payload    Json
  isFavorite Boolean              @default(false)
  createdAt  DateTime             @default(now())

  @@unique([favoriteId, matchType, externalId])
  @@index([favoriteId])
  @@index([favoriteId, isFavorite])
  @@index([score])
  @@map("ProductPendingMatch")
}

/** Umbrales del agente automático TikTok (singleton id=default). */
model TikTokAgentSettings {
  id               String   @id @default("default")
  adsetPauseSpendPen    Float @default(10)
  campaignPauseSpendPen Float @default(30)
  adsetCpaCriticoPen    Float @default(15)
  telegramNotify        Boolean @default(true)
  /** Activar campañas apagadas a las 6:00 America/Lima. */
  activateAt6amEnabled  Boolean @default(false)
  /** IDs de campaña en cola para activar a las 6:00 (JSON string[]). */
  pendingActivateCampaignIds String @default("[]")
  /** Escalar presupuesto del mejor conjunto/anuncio del día. */
  scaleBestEnabled      Boolean @default(false)
  /** % de aumento de presupuesto diario al escalar (ej. 20 = +20%). */
  scaleBestBudgetIncreasePercent Float @default(20)
  updatedAt        DateTime @updatedAt

  @@map("TikTokAgentSettings")
}

/** Cuenta TikTok Ads conectada (credenciales para API). */
model TikTokAdAccount {
  id           String   @id @default(cuid())
  advertiserId String   @unique
  name         String
  accessToken  String
  refreshToken String?
  identityId   String?
  currency     String?
  timezone     String?
  country          String?
  advertiserStatus String?
  status           String   @default("active")
  isDefault    Boolean  @default(false)
  isDefaultForTests Boolean @default(false)
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, isDefault])
  @@index([status, isDefaultForTests])
  @@map("TikTokAdAccount")
}

/** Corrida del agente de comentarios Meta/Facebook (cron o manual). */
model MetaCommentAgentRun {
  id             String    @id @default(cuid())
  trigger        String
  status         String    @default("running")
  dryRun         Boolean   @default(false)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  pagesScanned   Int       @default(0)
  postsScanned   Int       @default(0)
  commentsSeen   Int       @default(0)
  actionsCount   Int       @default(0)
  summary        String?
  errorMessage   String?

  @@index([startedAt])
  @@map("MetaCommentAgentRun")
}

/** Configuración global del agente de comentarios (singleton id=default). */
model MetaCommentAgentSettings {
  id                      String   @id @default("default")
  country                 String   @default("CO")
  contactInfo             String?
  shippingTime            String?
  businessInfo            String?
  deleteNegativeEnabled   Boolean  @default(true)
  deletePrompt            String?
  deleteExamplesRemove    String?
  deleteExamplesKeep      String?
  publicReplyEnabled      Boolean  @default(true)
  publicReplyPrompt       String?
  publicReplyIncludeLink  Boolean  @default(true)
  publicReplyIncludePrice Boolean  @default(true)
  dmReplyEnabled          Boolean  @default(false)
  dmReplyPrompt           String?
  dmDataToCollect         String?
  /** Facebook Login for Business → Configuration ID (alternativa a META_OAUTH_CONFIG_ID en env). */
  metaOAuthConfigId       String?
  updatedAt               DateTime @updatedAt

  @@map("MetaCommentAgentSettings")
}

/** Producto/comentario configurable para el agente (catálogo). */
model MetaCommentProduct {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  tags        Json     @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@map("MetaCommentProduct")
}

/** Conexión OAuth de Facebook/Instagram: páginas autorizadas por el usuario. */
model MetaFacebookConnection {
  id           String    @id @default(cuid())
  pageId       String    @unique
  pageName     String
  pageCategory String?
  accessToken  String
  tokenExpires DateTime?
  connected    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([connected])
  @@map("MetaFacebookConnection")
}

/** Configuración de monitoreo y respuestas por página de Facebook. */
model MetaCommentPageConfig {
  id            String   @id @default(cuid())
  pageId        String   @unique
  pageName      String
  enabled       Boolean  @default(true)
  replyMode     String   @default("professional")
  replyTemplate String?
  websiteUrl    String?
  updatedAt     DateTime @updatedAt

  @@index([enabled])
  @@map("MetaCommentPageConfig")
}

/** Decisión del agente por comentario (dedupe por metaCommentId). */
model MetaCommentDecision {
  id             String   @id @default(cuid())
  runId          String?
  metaCommentId  String   @unique
  postStoryId    String?
  adId           String?
  pageId         String?
  authorName     String?
  message        String
  classification String
  action         String
  replyText      String?
  applied        Boolean  @default(false)
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([runId])
  @@map("MetaCommentDecision")
}

/** Entrada manual de URL + página de Facebook (Meta Ad Library). */
model MetaLibraryEntry {
  id                String    @id @default(cuid())
  url               String?
  facebookPage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastSyncedAt      DateTime?
  syncWarning       String?
  activeCount       Int?
  totalCount        Int?
  companyData       Json?
  adsData           Json?
  previewSlidesData Json?

  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@map("MetaLibraryEntry")
}

/** Corrida del agente TikTok (cron o manual). */
model TikTokAgentRun {
  id               String    @id @default(cuid())
  trigger          String
  status           String    @default("running")
  dryRun           Boolean   @default(false)
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  accountsScanned  Int       @default(1)
  campaignsScanned Int       @default(0)
  adgroupsScanned  Int       @default(0)
  actionsCount     Int       @default(0)
  summary          String?
  errorMessage     String?
  actions          Json      @default("[]")

  @@index([startedAt])
  @@map("TikTokAgentRun")
}

/** Corrida del agente de comentarios TikTok (cron o manual). */
model TikTokCommentAgentRun {
  id           String    @id @default(cuid())
  trigger      String
  status       String    @default("running")
  dryRun       Boolean   @default(false)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  adsScanned   Int       @default(0)
  commentsSeen Int       @default(0)
  actionsCount Int       @default(0)
  summary      String?
  errorMessage String?

  @@index([startedAt])
  @@map("TikTokCommentAgentRun")
}

/** Decisión del agente por comentario TikTok (dedupe por tiktokCommentId). */
model TikTokCommentDecision {
  id             String   @id @default(cuid())
  runId          String?
  tiktokCommentId String  @unique
  adId           String?
  tiktokItemId   String?
  identityId     String?
  identityType   String?
  authorName     String?
  message        String
  classification String
  action         String
  replyText      String?
  applied        Boolean  @default(false)
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([runId])
  @@map("TikTokCommentDecision")
}
