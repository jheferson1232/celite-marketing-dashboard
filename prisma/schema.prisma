generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Chat {
  id              String           @id @default(cuid())
  title           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        Message[]
  telegramSession TelegramSession?
}

model TelegramSession {
  telegramUserId String   @id
  chatId         String   @unique
  chat           Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  platform       String   @default("meta")
  updatedAt      DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String
  parts     Json
  createdAt DateTime @default(now())
}

/** Campaña o conjunto Meta para Informe IA y cron de activación. */
model MetaTrackEntity {
  id             String   @id @default(cuid())
  metaId         String
  type           String
  name           String
  campaignMetaId String?
  objective      String?
  updatedAt      DateTime @updatedAt
  operativeDays  MetaOperativeDay[]

  @@unique([metaId, type])
  @@index([type, campaignMetaId])
}

/** Snapshot diario por campaña/conjunto: gasto, ventas, puntos y estado (Informe IA). */
model MetaOperativeDay {
  id            String          @id @default(cuid())
  date          String
  entityId      String
  entity        MetaTrackEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  intentActive  Boolean         @default(false)
  metaWasActive Boolean         @default(false)
  sold          Boolean         @default(false)
  purchases     Int             @default(0)
  spend         Float           @default(0)
  cpa           Float           @default(0)
  points        Int?
  estadoKind    String          @default("neutral")
  estadoLabel   String          @default("—")
  notifyOlvido  Boolean         @default(false)
  rowHighlight  String          @default("none")
  updatedAt     DateTime        @updatedAt

  @@unique([date, entityId])
  @@index([date])
  @@index([entityId, date])
}

/** Totales de cuenta Meta guardados por día (Informe IA). */
model MetaInformeAccountDay {
  date             String   @id
  accountSpend     Float    @default(0)
  accountPurchases Int      @default(0)
  syncedAt         DateTime @updatedAt
}

enum ProductStatus {
  draft
  ready
  running
  archived
}

enum CreativeType {
  image
  video
}

enum CampaignStatus {
  draft
  ready
  running
  archived
}

enum CampaignStrategy {
  ABO
}

/** Imagen o video reutilizable (asociable a variantes de producto). */
model Creative {
  id        String           @id @default(cuid())
  url       String           @unique
  type      CreativeType
  name      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[] @relation("CreativeToProductVariant")

  @@index([type])
  @@map("Creative")
}

/** Landing page reutilizable (asociable a varios productos). */
model LandingPage {
  id        String   @id @default(cuid())
  url       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]

  @@map("LandingPage")
}

/** Producto del catálogo (multi-plataforma). */
model Product {
  id           String        @id @default(cuid())
  name         String
  status       ProductStatus @default(draft)
  budget       Float         @default(0)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  variants     ProductVariant[]
  campaigns    ProductCampaign[]
  landingPages LandingPage[]

  @@index([status])
  @@map("TikTokProduct")
}

/** Variante del producto con creativos propios. */
model ProductVariant {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  updatedAt DateTime   @updatedAt
  creatives Creative[] @relation("CreativeToProductVariant")

  @@index([productId])
  @@map("TikTokProductVariant")
}

/** URL de landing guardada en catálogo global (reutilizable en productos). */
model LandingUrlCatalog {
  id        String   @id @default(cuid())
  url       String   @unique
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("LandingUrlCatalog")
}

/** Campaña TikTok configurable (borrador → lanzamiento). */
model Campaign {
  id        String         @id @default(cuid())
  name      String
  status    CampaignStatus @default(draft)
  strategy  CampaignStrategy
  config    Json
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
  @@map("Campaign")
}

/** Campaña vinculada a un producto para historial de ventas. */
model ProductCampaign {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  campaignId   String
  campaignName String?
  platform     String   @default("tiktok")
  createdAt    DateTime @default(now())

  @@unique([productId, campaignId, platform])
  @@index([productId])
  @@map("TikTokProductCampaign")
}

/** Ejecución manual de sincronización Dropi → SociaVault. */
model PendingSyncRun {
  id           String    @id @default(cuid())
  status       String    @default("running")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  imported     Int       @default(0)
  searched     Int       @default(0)
  matched      Int       @default(0)
  noMatch      Int       @default(0)
  errors       Int       @default(0)
  errorMessage String?

  @@index([startedAt])
  @@map("PendingSyncRun")
}

/** Favorito importado desde Dropi (productos pendientes). */
model DropiFavoriteProduct {
  id           String   @id @default(cuid())
  dropiId      String   @unique
  name         String
  url          String?
  imageUrl     String?
  imageUrls    Json     @default("[]")
  sku          String?
  price        Float?
  status       String   @default("IMPORTED")
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  matches      ProductPendingMatch[]

  @@index([status])
  @@index([updatedAt])
  @@map("DropiFavoriteProduct")
}

/** Resultado de búsqueda SociaVault (campaña Meta o video TikTok). */
model ProductPendingMatch {
  id         String               @id @default(cuid())
  favoriteId String
  favorite   DropiFavoriteProduct @relation(fields: [favoriteId], references: [id], onDelete: Cascade)
  matchType  String
  externalId String?
  title      String?
  pageName   String?
  score      Float                @default(0)
  previewUrl String?
  landingUrl String?
  payload    Json
  isFavorite Boolean              @default(false)
  createdAt  DateTime             @default(now())

  @@unique([favoriteId, matchType, externalId])
  @@index([favoriteId])
  @@index([favoriteId, isFavorite])
  @@index([score])
  @@map("ProductPendingMatch")
}

/** Umbrales del agente automático TikTok (singleton id=default). */
model TikTokAgentSettings {
  id               String   @id @default("default")
  adsetPauseSpendPen    Float @default(10)
  campaignPauseSpendPen Float @default(30)
  adsetCpaCriticoPen    Float @default(15)
  telegramNotify        Boolean @default(true)
  updatedAt        DateTime @updatedAt

  @@map("TikTokAgentSettings")
}

/** Cuenta TikTok Ads conectada (credenciales para API). */
model TikTokAdAccount {
  id           String   @id @default(cuid())
  advertiserId String   @unique
  name         String
  accessToken  String
  refreshToken String?
  identityId   String?
  currency     String?
  timezone     String?
  country      String?
  status       String   @default("active")
  isDefault    Boolean  @default(false)
  isDefaultForTests Boolean @default(false)
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, isDefault])
  @@index([status, isDefaultForTests])
  @@map("TikTokAdAccount")
}

/** Corrida del agente TikTok (cron o manual). */
model TikTokAgentRun {
  id               String    @id @default(cuid())
  trigger          String
  status           String    @default("running")
  dryRun           Boolean   @default(false)
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  accountsScanned  Int       @default(1)
  campaignsScanned Int       @default(0)
  adgroupsScanned  Int       @default(0)
  actionsCount     Int       @default(0)
  summary          String?
  errorMessage     String?
  actions          Json      @default("[]")

  @@index([startedAt])
  @@map("TikTokAgentRun")
}
