# Resumen: conversión TikTok PEN → COP (solo pestaña /resumen). Ej: 1050 = 1 PEN = 1050 COP
PEN_TO_COP_RATE=1050

# --- Informe IA (/informe-ia) + cron Meta → Telegram ---
# Cron: Authorization: Bearer <CRON_SECRET> en /api/cron/meta-telegram-reports (cada hora en vercel.json)
CRON_SECRET=

# Primer día del historial en tabla (YYYY-MM-DD, America/Lima). No puede ser antes de ayer.
# META_INFORME_START_DATE=2026-05-21

# Meta Ads (informe IA y dashboard comparten token/cuenta)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Telegram: informe horario + botón "Enviar a Telegram" en /informe-ia
TELEGRAM_BOT_TOKEN=
# IDs permitidos (coma). Ej: 7272335506 o 111,222
TELEGRAM_ALLOWED_USER_IDS=

# OpenAI: solo redacta el texto del mensaje de Telegram (opcional; sin key usa plantilla fija)
# OPENAI_API_KEY=

# TikTok Ads
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
# Opcional: identity para creativos (si no está en el JSON de campaña)
TIKTOK_IDENTITY_ID=
# Carpeta de configs JSON (default: config/tiktok-campaigns)
TIKTOK_CAMPAIGN_CONFIG_DIR=
# Carpeta por defecto de videos .mp4 (Telegram y fallback)
TIKTOK_VIDEOS_DEFAULT_DIR=D:\calzados\tesla

# Notion — tabla Campañas (lanzar desde Borrador)
NOTION_TOKEN=
NOTION_CAMPAIGNS_DB=

# OpenAI (asistente general + redacción informe Meta si está definida arriba)
OPENAI_API_KEY=

# Base de datos (PostgreSQL). En Vercel usa un host en la nube (Neon, Supabase, Vercel Postgres);
# localhost no es accesible desde el servidor de producción.
DATABASE_URL=
# Opcional (Neon): URL sin "-pooler" para migraciones. Si no está, se deriva de DATABASE_URL.
# DIRECT_URL=

# URL pública de la app (webhook Telegram). Con ngrok: https://xxxx.ngrok-free.app
NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# ngrok (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=

# Secreto opcional para validar el webhook del bot (comandos / webhook)
TELEGRAM_WEBHOOK_SECRET=
