# Resumen: conversión TikTok PEN → COP (solo pestaña /resumen). Ej: 1050 = 1 PEN = 1050 COP
PEN_TO_COP_RATE=1050

# --- Informe IA (/informe-ia) + cron Meta → Telegram ---
# Cron: Authorization: Bearer <CRON_SECRET> en /api/cron/meta-telegram-reports (GitHub Actions)
CRON_SECRET=

# --- Agente TikTok (/tiktok/agente) — 3x día vía GitHub Actions ---
# GET /api/cron/tiktok-agent?trigger=morning_8am|afternoon_2pm|evening_8pm
# Umbrales en soles (PEN) en BD, alineados al dashboard TikTok

# Primer día del historial en tabla (YYYY-MM-DD, America/Lima). Ej: 2026-05-21
META_INFORME_START_DATE=2026-05-21

# Meta Ads (informe IA y dashboard comparten token/cuenta)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Telegram: informe horario + botón "Enviar a Telegram" en /informe-ia
TELEGRAM_BOT_TOKEN=
# IDs permitidos (coma). Ej: 7272335506 o 111,222
TELEGRAM_ALLOWED_USER_IDS=

# OpenAI: solo redacta el texto del mensaje de Telegram (opcional; sin key usa plantilla fija)
# OPENAI_API_KEY=

# TikTok Ads
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
# OAuth — conectar cuentas en /tiktok/cuentas (app en business-api.tiktok.com)
# App Celite (7637379122192187393); redirect debe coincidir con el portal TikTok
TIKTOK_APP_ID=7637379122192187393
TIKTOK_APP_SECRET=
# Producción: https://celite-marketing-dashboard.vercel.app/api/tiktok/oauth/callback
# Local: http://localhost:3000/api/tiktok/oauth/callback
# TIKTOK_OAUTH_REDIRECT_URI=
# Opcional: identity para creativos (si no está en el JSON de campaña)
TIKTOK_IDENTITY_ID=
# Carpeta de configs JSON (default: config/tiktok-campaigns)
TIKTOK_CAMPAIGN_CONFIG_DIR=
# Carpeta por defecto de videos .mp4 (Telegram y fallback)
TIKTOK_VIDEOS_DEFAULT_DIR=D:\calzados\tesla

# Notion — tabla Campañas (lanzar desde Borrador)
NOTION_TOKEN=
NOTION_CAMPAIGNS_DB=

# Anthropic Claude — agente comentarios Facebook (/meta/comentarios)
ANTHROPIC_API_KEY=
# Token de Página (recomendado). Sin esto, el token de ads debe tener pages_manage_engagement.
# META_PAGE_ACCESS_TOKEN=
# META_PAGE_ID=

# OpenAI (asistente general + redacción informe Meta si está definida arriba)
OPENAI_API_KEY=

# Base de datos (PostgreSQL). En Vercel usa un host en la nube (Neon, Supabase, Vercel Postgres);
# localhost no es accesible desde el servidor de producción.
DATABASE_URL=
# Integración Vercel+Neon: URL directa para migraciones en build (prioritaria si existe).
# DATABASE_URL_UNPOOLED=
# Opcional manual: DIRECT_URL=

# URL pública de la app (webhook Telegram). Con ngrok: https://xxxx.ngrok-free.app
NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# ngrok (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=

# Secreto opcional para validar el webhook del bot (comandos / webhook)
TELEGRAM_WEBHOOK_SECRET=

# Vercel Blob — productos (/products), creatives (baúl) y media scrapeado (TikTok/Instagram en productos pendientes)
BLOB_READ_WRITE_TOKEN=

# --- Productos pendientes (/productos-pendientes): Dropi favoritos + SociaVault ---
# Dropi — opción A (recomendada en WSL): token del navegador tras login en app.dropi.co
# DROPI_TOKEN=
# DROPI_LOGIN_RESULT_JSON=
# DROPI_USER_ID=
# DROPI_COUNTRY_HOST=co
# Dropi — opción B: scraper Playwright (email/contraseña)
DROPI_EMAIL=
DROPI_PASSWORD=
# Si Playwright no encuentra Chromium:
# pnpm dlx @puppeteer/browsers install chrome@stable --path ~/.cache/puppeteer-browsers
# PLAYWRIGHT_CHROME_EXECUTABLE=~/.cache/puppeteer-browsers/chrome/linux-.../chrome-linux64/chrome
# Opcional: URLs si cambian en Dropi
# DROPI_LOGIN_URL=https://app.dropi.co/login
# DROPI_FAVORITES_URL=https://app.dropi.co/dashboard/search?search_type=simple&favorite=true&order_by=created_at&order_type=desc
# Pruebas sin scraper: array JSON de favoritos [{ "dropiId": "1", "name": "Producto" }]
# DROPI_FAVORITES_JSON=
# SociaVault — https://sociavault.com/dashboard (1 crédito ≈ 1 llamada API)
SOCIAVAULT_API_KEY=
# Modo ahorro (default true): 1 consulta, sin visión OpenAI por defecto
SOCIAVAULT_ECONOMY_MODE=true
# Búsqueda SociaVault — solo TikTok (~1 crédito por consulta):
SOCIAVAULT_SEARCH_INSTAGRAM=false
SOCIAVAULT_SEARCH_TIKTOK=true
SOCIAVAULT_MAX_QUERIES=1
# Máximo de videos TikTok guardados por consulta
SOCIAVAULT_MAX_MATCHES_PER_PLATFORM=30
# Instagram desactivado (legacy; no usar):
# SOCIAVAULT_INSTAGRAM_ENRICH=false
# SOCIAVAULT_INSTAGRAM_MAX_ENRICH=0
# OpenAI: 1 frase desde la foto (no gasta créditos SociaVault; default false en modo ahorro)
# SOCIAVAULT_IMAGE_VISION=true
# Proxy/región TikTok (código ISO 2 letras, ej. CO, VE)
# SOCIAVAULT_TIKTOK_REGION=CO
# Excluir resultados irrelevantes (separados por coma)
# SOCIAVAULT_EXCLUDE_PHRASES=purificador de aire,air purifier
